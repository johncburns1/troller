# Troller Configuration
# Copy this file to .env and customize for your environment

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=troller-task-queue

# GitHub Configuration
GITHUB_TOKEN=  # Optional for public repos, required for private repos
GITHUB_API_URL=https://api.github.com

# Claude AI Model Configuration
# Configure which Claude model to use for each agent type
CLAUDE_PLANNING_MODEL=claude-opus-4-5-20251101      # Planning agent (most capable)
CLAUDE_CODING_MODEL=claude-sonnet-4-5-20250929      # Coding agent (balanced capability/cost)
CLAUDE_REVIEW_MODEL=claude-sonnet-4-5-20250929      # Review agent (sufficient for review)

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
